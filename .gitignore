# Repository profiles are personal configuration, not toolkit content. They name real repositories,
# real environments, and sometimes an employer's internal rules, so they are ignored by default and
# stay on the machine that wrote them. Only the schema and the example ship.
#
# This is deliberately an allowlist: a new profile is untracked unless someone opts it in, rather
# than tracked unless someone remembers to exclude it.
profiles/*.json
!profiles/_schema.json
!profiles/_example.json

# Anything explicitly marked local
*.local.*
*.local

# Secrets never belong here; these are backstops, not the primary defense
.env
.env.*
*.pem
*.key

.DS_Store
node_modules/
